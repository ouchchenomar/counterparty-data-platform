# Copier en .env si besoin. Aucune clé n'est nécessaire : l'API GLEIF est publique.

# Chemin de la base DuckDB (par défaut : data/warehouse/cdp.duckdb)
# CDP_DUCKDB_PATH=

# Linux uniquement : votre UID pour que le conteneur Airflow puisse écrire dans data/
# AIRFLOW_UID=50000

# Version cloud (feuille de route)
# GCP_PROJECT_ID=
